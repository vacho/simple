#!/bin/sh
# Keeps app code off main (change-flow skill, ADRs 0017, 0024 and 0025): on main,
# only the plan, project docs (docs/) and agent tooling may be committed. App
# code (everything in app/, ADR 0023), README.md included, reaches main through a merge of a change/, fix/,
# chore/, build/ or ci/ branch.

branch=$(git symbolic-ref --short -q HEAD)
[ "$branch" = "main" ] || exit 0

# Concluding a merge (git commit after resolving conflicts) is allowed.
[ -f "$(git rev-parse --git-path MERGE_HEAD)" ] && exit 0

# Ask Git for staged paths outside the allowlist with exclude pathspecs, so
# no file name (accents, spaces, newlines) is ever parsed here.
blocked=$(git diff --cached --name-only --diff-filter=ACDMRT -- . \
  ':(exclude)openspec/' ':(exclude)docs/' ':(exclude).claude/' ':(exclude).agents/' \
  ':(exclude).githooks/' ':(exclude,top)CLAUDE.md' ':(exclude,top)AGENTS.md')

if [ -n "$blocked" ]; then
  echo "pre-commit: these files can't be committed on main:" >&2
  echo "$blocked" | sed 's/^/  /' >&2
  echo "Commit code on a branch: use the change-flow skill (start or branch)." >&2
  exit 1
fi

exit 0
