# Runtime configuration, loaded with `node --env-file=.env build` (copy to .env).

# SQLite database file.
DATABASE_PATH=./data/app.db

# Where scheduled and pre-migration backups are written, and how many scheduled ones to keep.
BACKUP_DIR=./data/backups
BACKUP_KEEP=14

# adapter-node: listening address.
HOST=0.0.0.0
PORT=3000

# Form submissions from any origin but the app's own are rejected. The origin comes from the
# request (https, unless PROTOCOL_HEADER says otherwise), or from APP_ORIGIN at build time:
# build with APP_ORIGIN=http://localhost:3000 to serve over plain http without a proxy.

# Behind a reverse proxy, uncomment and set to the headers the proxy sends.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
