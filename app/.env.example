# Runtime configuration, loaded with `node --env-file=.env build` (copy to .env).

# SQLite database file.
DATABASE_PATH=./data/app.db

# Where scheduled and pre-migration backups are written, and how many scheduled ones to keep.
BACKUP_DIR=./data/backups
BACKUP_KEEP=14

# adapter-node: listening address.
HOST=0.0.0.0
PORT=3000

# Behind a reverse proxy, uncomment and set to the headers the proxy sends.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
