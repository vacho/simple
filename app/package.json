{
	"name": "simple",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"; git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
		"check": "npm run i18n:gen && npm run i18n:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker && eslint . && npm run lint:css && prettier --check .",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"i18n:gen": "node --import tsx scripts/gen-messages.ts",
		"predev": "npm run i18n:gen",
		"prebuild": "npm run i18n:gen",
		"db:generate": "drizzle-kit generate",
		"i18n:check": "node --import tsx scripts/check-messages.ts",
		"i18n:status": "node --import tsx scripts/i18n-status.ts",
		"i18n:sort": "node --import tsx scripts/i18n-sort.ts",
		"test:e2e:pseudo": "I18N_PSEUDO=1 playwright test --grep @screens",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"icons": "node --import tsx scripts/gen-icons.ts",
		"backup": "node --import tsx scripts/backup.ts",
		"check:scenarios": "node --import tsx scripts/check-scenarios.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-boundaries": "^7.4.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"postcss-html": "^2.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"stylelint": "^17.16.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17"
	},
	"dependencies": {
		"@formatjs/icu-messageformat-parser": "^3.5.22",
		"@node-rs/argon2": "^2.2.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"intl-messageformat": "^12.1.4",
		"tsx": "^4.23.15",
		"valibot": "^1.5.0"
	}
}
